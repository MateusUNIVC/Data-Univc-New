# Supabase > Project Settings / API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Supabase > Connect > Session pooler (recommended for Render if IPv4 is needed)
DATABASE_URL=postgresql+psycopg://postgres.SEUREF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Production
ENVIRONMENT=production
# Production readiness requires database/027 and every later migration.
REQUIRE_SCHEMA_VERSION=true
AUTH_DISABLED=false
COOKIE_SECURE=true
DEFAULT_DIRECTORATE_CODE=DTNH
AUTO_CREATE_DB=false

# Identity, Session & Frontend Authorization v0.9.6.1
# Supabase valida e-mail/senha apenas no login; requests normais usam tokens locais Data UNIVC.
# Gere segredos fortes e mantenha-os somente no ambiente do servidor.
DATA_UNIVC_JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
# Keyring recomendado em produção. Mantenha a chave anterior até os access tokens expirarem.
DATA_UNIVC_JWT_KEYS_JSON={"2026-09-a":"SUBSTITUA_POR_SEGREDO_1_COM_32_OU_MAIS_CARACTERES","2026-09-b":"SUBSTITUA_POR_SEGREDO_2_COM_32_OU_MAIS_CARACTERES"}
DATA_UNIVC_JWT_ACTIVE_KID=2026-09-a
DATA_UNIVC_JWT_ISSUER=data-univc
DATA_UNIVC_JWT_AUDIENCE=data-univc-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=86400
JWT_CLOCK_SKEW_SECONDS=30
SESSION_ABSOLUTE_TTL_SECONDS=86400
SESSION_IDLE_TTL_SECONDS=86400
MAX_ACTIVE_SESSION_FAMILIES_PER_USER=5
LOGIN_RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_EMAIL_FAILURES=30
LOGIN_RATE_LIMIT_IP_FAILURES=0
# Se vazio, fingerprints de auditoria usam DATA_UNIVC_JWT_SECRET como HMAC.
DATA_UNIVC_FINGERPRINT_SECRET=

# Observability and production hardening
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
MAX_XLSX_UNCOMPRESSED_MB=250

# Excel generation. Keep one concurrent export on small/free instances.
EXCEL_EXPORT_CONCURRENCY=1
EXCEL_EXPORT_WAIT_SECONDS=10
ACADEMIC_EXCEL_INPUT_RESERVE_ROWS=250
# Executive chart windows. Full history is still exported to the bases.
ACADEMIC_EXCEL_CHART_NPS_SEMESTERS=8
ACADEMIC_EXCEL_CHART_PERIODS=12
MAX_DASHBOARD_WINDOW=12000

# DM / integração com o SEI. Mantido false em produção para não persistir HTML/XML de diagnóstico.
SEI_DM_DEBUG=false

# DADM / TALLOS Analytics Center
# Produção: configure o token somente no ambiente do servidor.
# Homologação local: TESTAR_DADM.bat permite validar e salvar o token pela própria tela;
# o valor é persistido apenas no .env local, que está no .gitignore. Nunca vai para HTML/localStorage.
TALLOS_API_TOKEN=
TALLOS_BASE_URL=https://api.tallos.com.br
TALLOS_PAGE_LIMIT=49
TALLOS_REQUEST_TIMEOUT=60
TALLOS_REQUEST_RETRIES=4
TALLOS_CHUNK_DAYS=90

# Reitoria / gerenciamento de identidades (somente backend)
# Supabase > Settings > API Keys > Secret keys. NUNCA exponha esta chave no frontend.
# Para projetos novos use a chave sb_secret_... abaixo.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
# Compatibilidade opcional com projetos legados que ainda usam service_role JWT (eyJ...).
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxx
SUPABASE_AVATAR_BUCKET=data-univc-avatars

# Diretorias temporariamente indisponiveis na navegacao e nas APIs.
# Os grants e dados permanecem preservados. Use vazio para publicar todas novamente.
HIDDEN_DIRECTORATE_CODES=DPE
